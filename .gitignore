/target
**/*.rs.bk
.DS_Store
.env
.env.*
!.env.example
*.swp
.idea/
.vscode/

# Model caches downloaded by fastembed at runtime. We let the cache live
# wherever the workload is run from; project-root downloads must not be
# committed (bge-small alone is 126 MB, past GitHub's 100 MB hard limit).
.fastembed_cache/
**/.fastembed_cache/

# Auto-generated by tauri-build (capability schemas, ACL manifests, …).
# Regenerated on every desktop build; committing them creates noise diffs.
apps/desktop/gen/

# Runtime artifacts from `cargo tauri dev`/`build` and the SQLite index
# written by the desktop binary if launched from the repo root.
evidence.db
evidence.db-shm
evidence.db-wal
